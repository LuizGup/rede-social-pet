// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum UserType{
  ADMIN_USER
  DEFAULT_USER
}

enum NotificationType{
  LIKE
  COMMENT
  FOLLOW
}

model Users{
  user_id                   Int       @id @default(autoincrement())
  user_name                 String
  user_email                String    @unique
  user_password             String
  user_type                 UserType?  @default(DEFAULT_USER)
  user_registration_date    DateTime  @default(now())
  user_photo                String?   @default("/images/DEFAULTIMAGE.png")
  user_bio                  String?
  user_contact              String?

  posts                   Posts[]
  likes                   Likes[]
  comments                Comments[]
  following               Follows[] @relation("Following")   // quem este usuário segue
  followers               Follows[] @relation("Followers")   // quem segue este usuário
  notifications_received  Notifications[] @relation("NotificationsReceived")
  notifications_sent      Notifications[] @relation("NotificationsSent")
  messages_sent           Messages[] @relation("MessagesSent")
  messages_received       Messages[] @relation("MessagesReceived")
}


model Posts{
  post_id           Int       @id @default(autoincrement())
  post_content      String
  post_media        String?
  post_created_at   DateTime  @default(now())

  fk_author_id      Int

  author Users @relation(fields: [fk_author_id], references: [user_id])
  @@index([fk_author_id])

  likes         Likes[]
  comments      Comments[]
  notifications Notifications[]
}


model Likes{
  like_id       Int       @id @default(autoincrement())
  like_date     DateTime  @default(now())

  fk_post_id    Int
  fk_user_id    Int

  post Posts @relation(fields: [fk_post_id], references: [post_id], onDelete: Cascade)
  @@index([fk_post_id])

  user Users @relation(fields: [fk_user_id], references: [user_id])
  @@index([fk_user_id])

  @@unique([fk_user_id, fk_post_id])
}


model Comments{
  comment_id        Int       @id @default(autoincrement())
  comment_content   String
  comment_date      DateTime  @default(now())

  fk_post_id        Int
  fk_user_id        Int

  post Posts @relation(fields: [fk_post_id], references: [post_id], onDelete: Cascade)
  @@index([fk_post_id])

  user Users @relation(fields: [fk_user_id], references: [user_id])
  @@index([fk_user_id])
}


model Follows{
  follow_id         Int       @id @default(autoincrement())
  follow_date       DateTime  @default(now())

  fk_follower_id    Int       // quem segue
  fk_followed_id    Int       // quem é seguido

  follower Users @relation("Following", fields: [fk_follower_id], references: [user_id])
  @@index([fk_follower_id])

  followed Users @relation("Followers", fields: [fk_followed_id], references: [user_id])
  @@index([fk_followed_id])

  @@unique([fk_follower_id, fk_followed_id])
}


model Notifications{
  notification_id     Int               @id @default(autoincrement())
  notification_type   NotificationType
  notification_read   Boolean           @default(false)
  created_at          DateTime          @default(now())

  fk_recipient_id     Int               // quem recebe a notificação
  fk_actor_id         Int               // quem gerou a ação
  fk_post_id          Int?              // post relacionado (curtida/comentário)

  recipient Users @relation("NotificationsReceived", fields: [fk_recipient_id], references: [user_id])
  @@index([fk_recipient_id])

  actor Users @relation("NotificationsSent", fields: [fk_actor_id], references: [user_id])
  @@index([fk_actor_id])

  post Posts? @relation(fields: [fk_post_id], references: [post_id], onDelete: Cascade)
  @@index([fk_post_id])
}


model Messages{
  message_id        Int       @id @default(autoincrement())
  message_content   String
  message_read      Boolean   @default(false)
  created_at        DateTime  @default(now())

  fk_sender_id      Int
  fk_receiver_id    Int

  sender Users @relation("MessagesSent", fields: [fk_sender_id], references: [user_id])
  @@index([fk_sender_id])

  receiver Users @relation("MessagesReceived", fields: [fk_receiver_id], references: [user_id])
  @@index([fk_receiver_id])
}